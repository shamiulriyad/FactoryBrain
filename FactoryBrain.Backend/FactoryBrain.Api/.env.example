# ─── BunonBrain / factoryBrain environment ────────────────────────────────
#
# Template for the ASP.NET Core API. Copy to .env next to this file.
#   • DotNetEnv loads .env and then .env.local from the API process's
#     WORKING DIRECTORY at startup (Program.cs: Env.Load(".env")). Variables
#     already set in the real environment win (clobberExistingVars: false).
#     Run `dotnet run` from this directory so this file is the one loaded.
#   • Next.js does NOT read this file. It reads .env* from the repo root;
#     see the root .env.example. The frontend-flavoured keys below are kept
#     for reference only. Full reference: docs/ENVIRONMENT.md
#
# Do NOT commit secrets.

# ─── Frontend / Next.js ───────────────────────────────────────────────────

# Render the internal architecture page at /dev/architecture.
# Leave at false for customer builds. When false the route returns 404.
NEXT_PUBLIC_SHOW_ARCHITECTURE=false

# App display name. NOTE: not read by any current code — titles and the
# topbar are hard-coded. Kept so existing env files stay valid.
NEXT_PUBLIC_APP_NAME=BunonBrain

# ─── Frontend → Backend bridge ────────────────────────────────────────────
# The Next.js dev server proxies /api/* to one of these URLs (in priority
# order: NEXT_PUBLIC_API_URL → DOTNET_API_URL → http://localhost:5000).
# Override per environment (e.g. http://10.0.0.5:5000 for staging).
NEXT_PUBLIC_API_URL=http://localhost:5000
DOTNET_API_URL=http://localhost:5000
# BACKEND_URL is not read by any code in this repo (kept for compatibility).
BACKEND_URL=http://localhost:5000

# ─── Admin token (server-only secret) ─────────────────────────────────────
# Gates POST /api/settings/llm, /api/rag/ingest and /api/rag/reindex
# ([AdminToken] filter, constant-time compare of the X-Admin-Token header).
# Unset outside Development → those routes return 403. In Development the
# check is skipped entirely (see docs/SECURITY_ANALYSIS.md F-2.3).
# The Next.js server must hold the SAME value so its admin proxy can
# forward it. Use a long random string. NEVER prefix with NEXT_PUBLIC_.
# ADMIN_API_TOKEN=

# ─── LLM adapter (optional) ───────────────────────────────────────────────
# When LLM_API_KEY is set, Ask BunonBrain and Agent runs forward to the
# model. Otherwise the deterministic demo answers are returned.

# Provider: gemini | openai | anthropic
LLM_PROVIDER=openai

# API key. NEVER prefix with NEXT_PUBLIC_. Leave blank and enter it in
# Settings → Advanced (/app/settings?section=advanced).
LLM_API_KEY=

# Model id. OpenAI default: gpt-6-luna.
LLM_MODEL=gpt-6-luna

# ─── RAG / Vector Retrieval (optional) ────────────────────────────────────
# When RAG_EMBEDDING_API_KEY is unset, factoryBrain falls back to a deterministic
# local hash embedder (MD5 token-frequency hashing + BM25 hybrid weighting).
# These variables are read by the .NET API (Program.cs -> EmbeddingProviderResolver).
# NOTE: Do NOT prefix with NEXT_PUBLIC_ — embedding keys must never reach the client.

# Embedding provider: local | openai | gemini (default local; falls back to local
# automatically if a hosted provider is selected without a key).
RAG_EMBEDDING_PROVIDER=

# Embedding model id (e.g. text-embedding-3-small, text-embedding-004).
# Defaults to text-embedding-3-small for openai and text-embedding-004 for gemini.
RAG_EMBEDDING_MODEL=

# Embedding API key. Falls back to LLM_API_KEY only when the provider matches
# LLM_PROVIDER (i.e. you genuinely intend to reuse the same key for both chat
# and embedding). Empty by default — leave unset for offline demos.
RAG_EMBEDDING_API_KEY=

# Output dimensionality. Falls back to Rag:EmbeddingDimensions, then 384.
RAG_EMBEDDING_DIMENSIONS=

# Hybrid retrieval knobs for the Next.js in-process RAG index. The .NET
# RagService does NOT read these; it uses the Rag__* keys further below.
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0
RAG_BM25_WEIGHT=0.35

# ─── Backend / ASP.NET Core (.NET 9) ──────────────────────────────────────

# PostgreSQL connection string. The factoryBrain backend uses pgvector.
# Make sure you have run: CREATE EXTENSION IF NOT EXISTS vector;
# Default: Supabase "Session pooler" string from Connect (IPv4, port 5432). Session mode is safe for migrations at startup.
# Option: the direct connection (Host=db.your-project-ref.supabase.co;Port=5432;Username=postgres) works only if your host supports IPv6, or you have Supabase's paid IPv4 add-on.
# Never use the transaction pooler on port 6543. Migrations run at startup and need a session connection.
FACTORYBRAIN_DB=Host=aws-0-your-region.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.your-project-ref;Password=your-db-password;SSL Mode=Require;Trust Server Certificate=true

# Local dev (Postgres 17 + pgvector on this machine):
# FACTORYBRAIN_DB=Host=localhost;Port=5432;Database=factorybrain;Username=postgres;Password=postgres

# The same keys are mirrored in appsettings.json, but env vars win.
Jwt__Issuer=factorybrain
Jwt__Audience=factorybrain
Jwt__SigningKey=change-me-to-a-long-random-string-please-32chars!

# ─── Authentication & Authorization (Step 52) ────────────────────────────
# JWT_SIGNING_KEY is the actual HMAC-SHA256 secret used to sign access
# tokens. REQUIRED in Production and must be ≥ 32 UTF-8 bytes — startup
# fails otherwise. In Development a missing/short key is replaced by a
# per-process random 32-byte key (tokens don't survive a restart). The
# config value (Jwt__SigningKey above) is ignored when JWT_SIGNING_KEY
# is set — this env var always wins.
# JWT_SIGNING_KEY=

# SameSite mode for the HttpOnly refresh cookie ("fb_refresh"). Accepted:
# Lax (default) | Strict | None. Case-insensitive. None forces Secure=true
# regardless of environment. Bad values fail startup with a clear message.
# AUTH_COOKIE_SAMESITE=Lax

# Optional: seed an Admin user on the very first migration. Both must be
# set; otherwise the seeder is a no-op. The seed runs only when no user
# with the same lowercased email already exists — safe to leave the
# env vars set on every restart.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me-immediately

# ─── Forwarded headers (Step 52) ───────────────────────────────────────────
# Set to "true" ONLY when the API runs behind a reverse proxy that
# rewrites X-Forwarded-For / X-Forwarded-Proto. Default off so a direct
# exposure cannot be tricked by an inbound header.
# FORWARDED_HEADERS_ENABLED=false
# Comma-separated exact IPs and/or CIDRs of trusted proxies. Empty
# (the default) logs a startup warning and trusts X-Forwarded-For from
# ANY sender — so anyone who can reach the API directly can spoof their
# client IP and bypass the login rate limit. Only leave the list empty
# when the API is reachable exclusively through the proxy; otherwise set
# TRUSTED_PROXIES to your proxy's IP/CIDR. Bad entries fail startup with
# the entry name in the message.
# TRUSTED_PROXIES=10.0.0.0/8,192.168.1.1

# ─── Realtime simulator (Step 53) ──────────────────────────────────────────
# Set to "true" to drive the live SignalR event stream from inside the
# API. When enabled, a hosted service generates a synthetic sensor
# reading every 5 s and refreshes the line board every 30 s through the
# same notifier path that /api/sensors/ingest and /api/line-board/refresh
# use — so connected clients see real `sensorReading` and
# `lineBoardUpdated` events without anyone touching the REST surface.
# Default off; never enabled unless this var is set.
# SIMULATOR_ENABLED=false
# Optional integer seed for the simulator's RNG. Two runs with the same
# seed produce the same first N sensor readings (after ignoring
# timestamps and ids). Unset = random seed, logged once at startup.
# Invalid values fail startup with the entry name in the message.
# SIMULATOR_SEED=42

# RAG embedding dimensions (matches pgvector column vector(384)).
Rag__EmbeddingDimensions=384
Rag__TopK=4
Rag__SimilarityThreshold=0
Rag__Bm25Weight=0.35

# ASP.NET Core bind URL.
ASPNETCORE_URLS=http://localhost:5000
DOTNET_ENVIRONMENT=Development

# ─── CORS allowlist (Step 51) ──────────────────────────────────────────────
# Comma-separated exact origins the API will respond with CORS headers for.
# Trims whitespace; no wildcard origins. The default (when this variable is
# unset) is http://localhost:5173 so a fresh checkout just-works with the
# most common Vite dev port. Allow any header, GET/POST/PUT/PATCH/DELETE,
# credentials. Examples:
#   CORS_ORIGINS=http://localhost:5173
#   CORS_ORIGINS=http://localhost:5173,http://localhost:4173
#   CORS_ORIGINS=https://app.example.com,https://staging.example.com
CORS_ORIGINS=http://localhost:5173
