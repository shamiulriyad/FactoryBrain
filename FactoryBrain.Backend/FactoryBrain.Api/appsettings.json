{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "factorybrain",
    "Audience": "factorybrain"
  },
  "Rag": {
    "TopK": 4,
    "SimilarityThreshold": 0,
    "Bm25Weight": 0.35,
    "LocalBm25Weight": 0.70,
    "LocalVectorWeight": 0.30,
    "HostedBm25Weight": 0.30,
    "HostedVectorWeight": 0.70,
    "MinScore": 0.10
  },
  "//RagEmbedding": "Provider/model/dims resolved at runtime from env vars RAG_EMBEDDING_PROVIDER, RAG_EMBEDDING_MODEL, RAG_EMBEDDING_API_KEY, RAG_EMBEDDING_DIMENSIONS. Defaults to local hash (384-d). Never read NEXT_PUBLIC_* for the API key.",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=factorybrain;Username=postgres;Password=postgres"
  }
}
