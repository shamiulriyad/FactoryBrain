# Copy to .env and fill in. Never commit .env.

# ── This service's own API (X-API-Key on every endpoint except /health) ──
# At least 24 characters, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
CV_API_KEY=change-me-to-a-long-random-value
CV_HOST=127.0.0.1
CV_PORT=8100

# ── The BunonBrain backend ──
CV_BACKEND_URL=http://localhost:5000
# Must equal CV_SERVICE_KEY in the backend's .env (at least 32 characters).
CV_BACKEND_SERVICE_KEY=change-me-to-the-backend-service-key

# ── Model ──
CV_MODEL_PATH=models/yolo11n.pt
# auto | cpu | cuda | cuda:0
CV_DEVICE=auto
CV_CONFIDENCE=0.40
CV_IMAGE_SIZE=640

# ── Processing ──
CV_PROCESS_FPS=8
CV_MAX_SESSIONS=4
CV_MIN_HITS=2
CV_LOST_AFTER_SECONDS=3
CV_TRACK_UPDATE_SECONDS=10
CV_ZONE_DEBOUNCE_FRAMES=2
CV_RECONNECT_ATTEMPTS=5
CV_RECONNECT_DELAY_SECONDS=3
CV_CONFIG_REFRESH_SECONDS=60
CV_WEBCAM_INDEX=0

# ── Events ──
CV_PUBLISH_EVENTS=true
CV_PUBLISH_QUEUE_SIZE=1000
CV_PUBLISH_MAX_ATTEMPTS=5

# ── Activity recognition (pose estimation + temporal classification) ──
# Off by default: it loads a second model (python scripts/download_model.py --pose).
# It predicts basic posture / movement only (STANDING, SITTING, WALKING, BENDING, REACHING or UNKNOWN):
# not sewing or other garment operations, not identities, not productivity.
CV_ACTIVITY_ENABLED=false
# * = every camera, or comma-separated camera codes / ids. A start request {"activity": true|false} overrides it.
CV_ACTIVITY_CAMERAS=*
CV_ACTIVITY_MODEL_PATH=models/pose/yolo11n-pose.pt
CV_ACTIVITY_POSE_CONFIDENCE=0.35
CV_ACTIVITY_KEYPOINT_CONFIDENCE=0.35
CV_ACTIVITY_IMAGE_SIZE=640
# Pose inferences per second per camera. On a laptop CPU, CV_PROCESS_FPS=5 with 2.5 here keeps one camera real-time;
# 8 + 4 needs a GPU (measured: see README "Performance").
CV_ACTIVITY_PROCESS_FPS=4
CV_ACTIVITY_WINDOW_SECONDS=3
CV_ACTIVITY_MIN_WINDOW_SECONDS=1
CV_ACTIVITY_MIN_OBSERVATIONS=4
CV_ACTIVITY_MAX_GAP_SECONDS=1.5
CV_ACTIVITY_RESET_AFTER_SECONDS=3
CV_ACTIVITY_MIN_CONFIDENCE=0.55
CV_ACTIVITY_CONFLICT_MARGIN=0.15
CV_ACTIVITY_MIN_STATE_SECONDS=1.5
CV_ACTIVITY_UNKNOWN_AFTER_SECONDS=3
CV_ACTIVITY_REPORT_SECONDS=15
CV_ACTIVITY_WALKING_SPEED=0.30
CV_ACTIVITY_MATCH_IOU=0.30
# baseline | sequence (needs a trained TorchScript model; none ships)
CV_ACTIVITY_CLASSIFIER=baseline
# CV_ACTIVITY_SEQUENCE_MODEL_PATH=models/activity/activity-gru.ts

# ── Garment activity recognition (trained model; docs/GARMENT_ACTIVITIES.md) ──
# Needs the pose model and an evaluated model listed in CV_GARMENT_CONFIG (copy configs/garment_inference.example.json).
CV_GARMENT_ENABLED=false
CV_GARMENT_CONFIG=configs/garment_inference.json

# ── Development only (keep false in production) ──
CV_ENABLE_PREVIEW=false
CV_PREVIEW_WINDOW=false
# Draw pose keypoints in the preview (preview.jpg?pose=false hides them)
CV_PREVIEW_POSE=true
CV_ALLOW_SOURCE_OVERRIDE=false

CV_LOG_LEVEL=INFO
