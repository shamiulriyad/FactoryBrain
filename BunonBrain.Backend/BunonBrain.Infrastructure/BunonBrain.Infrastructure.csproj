<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BunonBrain.Infrastructure</RootNamespace>
    <AssemblyName>BunonBrain.Infrastructure</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <LangVersion>13.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Replicate the Microsoft.Extensions.* implicit usings the source
      files rely on. The original BunonBrain.Api compiled under
      Microsoft.NET.Sdk.Web which auto-imported these.
      ASP.NET namespaces are NOT included here: Infrastructure is a
      pure class library. Code that needs IWebHostEnvironment should use
      IHostEnvironment from Microsoft.Extensions.Hosting.Abstractions.
    -->
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!-- Persistence -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>none</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="Pgvector" Version="0.3.2" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />

    <!-- Hosting, options, logging, HTTP and System.Text.Json come from the
         Microsoft.AspNetCore.App framework reference below. -->

    <!-- Auth (batch 52): PasswordHasher<User> lives in
         Microsoft.AspNetCore.Identity; JwtSecurityTokenHandler lives
         in System.IdentityModel.Tokens.Jwt; both come transitively
         from JwtBearer in the Api project — Infrastructure is a class
         library so we have to declare them explicitly. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />

    <!-- Config / env -->
    <PackageReference Include="DotNetEnv" Version="3.1.1" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BunonBrain.Application\BunonBrain.Application.csproj" />
  </ItemGroup>

</Project>
