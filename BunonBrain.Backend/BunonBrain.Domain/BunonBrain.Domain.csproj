<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BunonBrain.Domain</RootNamespace>
    <AssemblyName>BunonBrain.Domain</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <LangVersion>13.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ManualDocument.Embedding is a pgvector column; the property's CLR type
      is `Pgvector.Vector`. Domain has no EF/ASP.NET/Npgsql refs but does
      need the value-type POCO that represents an embedding on the entity.
      Infrastructure projects that use EF Core against pgvector continue
      to depend on `Pgvector.EntityFrameworkCore` directly.
    -->
    <PackageReference Include="Pgvector" Version="0.3.2" />
  </ItemGroup>

</Project>
