# ═════════════════════════════════════════════════════════════════════════
#  FactoryBrain / BunonBrain: environment template for the WHOLE repo
#
#  Copy this file to `.env` in the repo root. That single file configures
#  all three apps:
#    • Next.js frontend   frontend/next.config.mjs loads the repo-root .env*
#    • .NET API           Program.cs walks up from its working directory to
#                         the first .env it finds (the repo root)
#    • Python PDF RAG     rag/config.py loads ../.env (its keys start with PYRAG_)
#
#  Real process env vars (shell, Docker, CI) always win over this file.
#  Never commit the real .env. Full reference: docs/ENVIRONMENT.md
# ═════════════════════════════════════════════════════════════════════════


# ─── Frontend (Next.js) ───────────────────────────────────────────────────
# NEXT_PUBLIC_* values are exposed to the browser. Everything else is server-only.

# App display name. Not read by current code (titles are hard-coded).
NEXT_PUBLIC_APP_NAME=BunonBrain

# Render the internal architecture page at /dev/architecture. Keep false for
# customer builds; when false the route returns 404.
NEXT_PUBLIC_SHOW_ARCHITECTURE=false

# Backend URL. The /api/* rewrite prefers NEXT_PUBLIC_API_URL, the admin proxy
# prefers DOTNET_API_URL. Keep both equal. Default: http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000
DOTNET_API_URL=http://localhost:5000
# Not read by any code; kept for compatibility.
BACKEND_URL=http://localhost:5000


# ─── Admin token (retired) ────────────────────────────────────────────────
# ADMIN_API_TOKEN is no longer read by the frontend or the API. Admin actions
# (POST /api/settings/llm, /api/rag/ingest, /api/rag/reindex) need a signed-in
# user with the Admin role — see SEED_ADMIN_EMAIL below. Remove any old value.


# ─── Database (PostgreSQL + pgvector) ─────────────────────────────────────
# Read by the API. Use ONE of the options below.
# On startup the API runs CREATE EXTENSION IF NOT EXISTS vector, applies EF Core
# migrations and seeds demo data.

# Option 1: local Docker
#   docker run -d --name fb-pg -p 5432:5432 -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=factorybrain pgvector/pgvector:pg16
FACTORYBRAIN_DB=Host=localhost;Port=5432;Database=factorybrain;Username=postgres;Password=postgres

# Option 2: Supabase. Dashboard → Connect → "Session pooler" (IPv4, port 5432).
# Never use the transaction pooler on port 6543: startup migrations need a
# session connection. The direct host (db.<ref>.supabase.co) needs IPv6 or the
# paid IPv4 add-on.
# FACTORYBRAIN_DB=Host=aws-0-<region>.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.<project-ref>;Password=<db-password>;SSL Mode=Require;Trust Server Certificate=true

# Supabase client keys for the frontend. Not used by the app yet.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key


# ─── LLM for Ask BunonBrain (API) ─────────────────────────────────────────
# Blank LLM_API_KEY = deterministic demo answers with a "demo mode" chip.
# NEVER prefix with NEXT_PUBLIC_.
# These are the STARTUP configuration, read once when the API starts. Once an
# Admin saves the LLM settings in Settings → Advanced, the saved settings
# (database, key encrypted) are used instead — including "cleared" — and
# these values no longer apply. See docs/AI_SETTINGS_DESIGN.md.
# Provider: openai | gemini | anthropic
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
# Optional OpenAI-compatible endpoint (scheme://host[:port], no path) instead
# of https://api.openai.com — e.g. a proxy or a self-hosted gateway. The
# end-to-end tests point it at a local fake model. Startup-only (not editable
# in the UI).
# LLM_BASE_URL=

# Encrypts API keys saved through Settings (AES-256-GCM). Base64 of exactly 32
# random bytes, e.g. `openssl rand -base64 32`. Keep it in a secret store,
# never in the database or the repo. Without it, API keys can't be saved in
# the UI (everything else still works). Alternatively point
# AI_SETTINGS_ENCRYPTION_KEY_FILE at a mounted secret file. To rotate: set the
# new key here and the old one in AI_SETTINGS_ENCRYPTION_KEY_PREVIOUS; each
# key is re-encrypted with the new key the next time it is saved.
AI_SETTINGS_ENCRYPTION_KEY=
# AI_SETTINGS_ENCRYPTION_KEY_FILE=
# AI_SETTINGS_ENCRYPTION_KEY_PREVIOUS=
# How long an API instance caches the saved settings (seconds, 0–30, default 1).
# The instance that saved a change uses it from the next request; other
# instances within this interval.
# AI_SETTINGS_REFRESH_SECONDS=1


# ─── Backend RAG (pgvector) ───────────────────────────────────────────────
# With no embedding key the API uses a deterministic local hash embedder
# (token-frequency hashing + BM25 hybrid weighting).
# Startup configuration for embeddings, separate from the LLM: an LLM key
# never changes the embedding provider or dimensions, and embeddings never use
# LLM_API_KEY. Once an Admin saves embedding settings, those win.
# The API NEVER resizes the vector column or re-embeds at startup: if these
# disagree with the stored vectors, search is keyword-only until an Admin
# reviews the plan and confirms (Settings → Advanced, or
# GET /api/rag/reindex/plan then POST /api/rag/reindex {confirmPlanId}).

# local | openai | gemini (default local)
RAG_EMBEDDING_PROVIDER=
# openai: text-embedding-3-small (1–1536 dims) | text-embedding-3-large (1–3072)
#         | text-embedding-ada-002 (1536); gemini: text-embedding-004 (768)
RAG_EMBEDDING_MODEL=
# Required for openai / gemini embeddings (LLM_API_KEY is not used).
RAG_EMBEDDING_API_KEY=
# Default: the model's native size (local: 384). Sent to OpenAI as "dimensions".
RAG_EMBEDDING_DIMENSIONS=
# Optional: your provider's price in USD per 1M embedding tokens, used for an
# upper-bound cost estimate before a reindex. Unset = "can't be estimated".
# RAG_EMBEDDING_PRICE_PER_MILLION_TOKENS_USD=

# API retrieval settings (RagConfig, env overrides appsettings.json "Rag").
# Hybrid weights: Rag__LocalBm25Weight / Rag__HostedBm25Weight and the
# matching *VectorWeight keys; RAG_HYBRID_BM25_WEIGHT overrides at runtime.
Rag__EmbeddingDimensions=384
Rag__TopK=4
Rag__SimilarityThreshold=0

# Knobs for the legacy Next.js in-process index (not on the live /api/ask path).
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0
RAG_BM25_WEIGHT=0.35


# ─── API (ASP.NET Core 9) ─────────────────────────────────────────────────
ASPNETCORE_URLS=http://localhost:5000
DOTNET_ENVIRONMENT=Development
ASPNETCORE_ENVIRONMENT=Development

# Comma-separated exact origins allowed by CORS. No wildcards.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT issuer/audience (mirrored in appsettings.json; env wins).
Jwt__Issuer=factorybrain
Jwt__Audience=factorybrain

# HS256 signing secret, ≥ 32 UTF-8 bytes. REQUIRED in Production (startup
# fails otherwise). In Development a random per-process key is generated.
# JWT_SIGNING_KEY=

# SameSite for the HttpOnly refresh cookie: Lax (default) | Strict | None.
# AUTH_COOKIE_SAMESITE=Lax

# Every API route except /health and /api/auth/{login,refresh,logout} needs a
# signed-in user, so at least one account must exist. Seed an Admin on startup
# (skipped if the email already exists). Both must be set. Roles:
#   Admin    — everything, including LLM settings and RAG ingest/reindex
#   Operator — operational writes (agent runs, QC flags, sensor ingest, alerts)
#   Viewer   — read-only
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me-immediately
# Optional read-only account.
# SEED_VIEWER_EMAIL=viewer@example.com
# SEED_VIEWER_PASSWORD=change-me-too
# Optional Operator account (operational writes; approvals up to medium risk).
# SEED_OPERATOR_EMAIL=operator@example.com
# SEED_OPERATOR_PASSWORD=change-me-three

# Self-service accounts. Anyone can sign up at /register; new accounts are
# always Viewer (read-only) and an Admin promotes them in Settings → Users.
# Set to false to allow only accounts created by an administrator.
# ALLOW_SELF_REGISTRATION=true

# Email for "Forgot password?" (one-time reset link, valid 30 minutes).
# Without SMTP_HOST nothing is sent; outside Production the email (with the
# link) is printed to the API console instead, so the flow can be tested.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_ENABLE_SSL=true
# SMTP_FROM=BunonBrain <no-reply@example.com>
# The frontend's public address, used in emailed links.
# PUBLIC_APP_URL=http://localhost:3000

# Login attempts per client IP per minute (default 5, allowed 1–1000).
# LOGIN_RATE_LIMIT_PER_MINUTE=5

# Set "true" ONLY behind a reverse proxy that rewrites X-Forwarded-*.
# FORWARDED_HEADERS_ENABLED=false
# Trusted proxy IPs/CIDRs. Empty trusts X-Forwarded-For from anyone, which
# lets direct callers bypass the login rate limit.
# TRUSTED_PROXIES=10.0.0.0/8,192.168.1.1

# Live sensor simulator: a reading every 5 s, line-board refresh every 30 s.
# This is the only thing that moves the demo data on its own: the Overview
# page now polls the read-only GET /api/sensors/snapshot instead of advancing
# the simulation, so without it the numbers change only on "Simulate tick".
# Each tick writes rows to sensor_readings, so prefer a local database.
# SIMULATOR_ENABLED=false
# Optional RNG seed for repeatable readings.
# SIMULATOR_SEED=42

# Machines without the .NET 9 runtime (only 8/10) need roll-forward. This must
# be set in the SHELL before `dotnet run`; it has no effect from this file.
#   PowerShell:  $env:DOTNET_ROLL_FORWARD = "Major"


# ─── Quality inspection (QC & defect detection) ───────────────────────────
# Read by the API once at startup. Uploaded images are stored as files, never
# in the database; the database keeps a server-generated storage key only.
#
# Vision provider for defect detection:
#   llm   the vision-capable model of the configured LLM provider (Settings →
#         AI, or LLM_PROVIDER / LLM_API_KEY): openai | anthropic | gemini.
#         Confidence is the model's own estimate and boxes are approximate.
#   http  your own detection model behind an HTTP endpoint (request/response
#         contract in ARCHITECTURE.md, "Quality inspection"). Best for
#         production thresholds.
#   unset / none  no AI analysis: inspections are stored, marked "not
#         configured", and can be inspected manually. Nothing is predicted.
# QC_VISION_PROVIDER=
# llm mode: a vision-capable model (defaults to LLM_MODEL).
# QC_VISION_MODEL=
# http mode: endpoint and optional bearer key (the key is never logged).
# QC_VISION_HTTP_URL=http://127.0.0.1:8100/detect
# QC_VISION_HTTP_API_KEY=
# Seconds per analysis (5–600, default 60); minimum confidence stored (0–1, default 0.25).
# QC_VISION_TIMEOUT_SECONDS=60
# QC_VISION_MIN_CONFIDENCE=0.25
# Automatic re-claims of an interrupted analysis before it is marked failed (default 3).
# QC_MAX_ATTEMPTS=3
# Image folder (default <API content root>/App_Data/qc-images; mount a
# persistent volume in Docker) and upload limit in MB (default 10, max 20).
# QC_IMAGE_STORAGE_PATH=
# QC_IMAGE_MAX_MB=10
# Run the background analysis worker in this API instance (default true).
# QC_WORKER_ENABLED=true


# ─── Production planning & line efficiency ────────────────────────────────
# Read by the API once at startup. Lines, shifts, styles, orders and output
# are entered by the plant (nothing is seeded); these only tune how they are
# evaluated. An invalid value falls back to its default and is logged.
#
# Plant time zone: shifts, plan dates, due dates and production dates are
# local to it. Default UTC. Use the IANA id on Linux / Docker (Asia/Dhaka) and
# the Windows id when the API runs on Windows (Bangladesh Standard Time): the
# API runs with invariant globalization, so Windows can't map IANA ids.
# PRODUCTION_TIME_ZONE=Asia/Dhaka
# The person who submits a plan / change / balance proposal can't be the one
# whose approval makes it live (default true).
# PRODUCTION_REQUIRE_SEPARATE_APPROVER=true
# How far back output may be recorded or corrected, days (1–366, default 31),
# and the longest single output interval, hours (1–24, default 12).
# PRODUCTION_MAX_BACKFILL_DAYS=31
# PRODUCTION_MAX_INTERVAL_HOURS=12
# Production days behind the observed rate for delay risk (1–30, default 3),
# and the slack, %, under which the required rate counts as medium risk
# (0–50, default 10).
# PRODUCTION_RATE_LOOKBACK_DAYS=3
# PRODUCTION_RISK_SLACK_PCT=10
# Time studies older than this are ignored by bottleneck analysis (days, default 14).
# PRODUCTION_OBSERVATION_MAX_AGE_DAYS=14


# ─── Python PDF RAG (rag/) ────────────────────────────────────────────────
# Every key except GOOGLE_API_KEY starts with PYRAG_ so it cannot clash with
# the API's settings (both have an LLM model, for example).

# Gemini key: answers, and embeddings when PYRAG_EMBEDDING_PROVIDER=google.
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Default PDF for `python ingest.py` with no --pdf flag (relative to rag/).
PYRAG_PDF_PATH=data/your-file.pdf

# Chunking
PYRAG_CHUNK_SIZE=1000
PYRAG_CHUNK_OVERLAP=150

# Embeddings. Re-ingest with --recreate after changing either line.
#   google      -> gemini-embedding-001                    (3072-dim, needs GOOGLE_API_KEY)
#   huggingface -> sentence-transformers/all-MiniLM-L6-v2  (fast, English, 384-dim)
#   huggingface -> BAAI/bge-m3                             (multilingual incl. Bangla, heavy)
PYRAG_EMBEDDING_PROVIDER=huggingface
PYRAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Leave empty to auto-detect the vector size.
PYRAG_EMBEDDING_DIM=

# Qdrant. The app needs the SERVER (main.py can't use the embedded store), so
# keep PYRAG_QDRANT_PATH empty:
#   docker run -d -p 6333:6333 -v factorybrain_qdrant:/qdrant/storage qdrant/qdrant
# PYRAG_QDRANT_PATH=qdrant_data is an embedded store for the CLI only.
PYRAG_QDRANT_URL=http://localhost:6333
PYRAG_QDRANT_API_KEY=
PYRAG_QDRANT_PATH=
# Collection the app answers from. `python ingest.py --pdf data/x.pdf` writes
# to it; the API queries it for Ask and agent runs.
PYRAG_COLLECTION_NAME=pdf_rag

# Where the API reaches the RAG service (`uvicorn main:app --port 8000` in rag/).
# Every Ask answer and agent finding comes from it; nothing answers without it.
PYRAG_SERVICE_URL=http://localhost:8000
# Seconds the API waits for one answer.
PYRAG_TIMEOUT_SECONDS=90

# Upload limit and scanned-PDF threshold
PYRAG_MAX_UPLOAD_MB=200
PYRAG_MIN_TEXT_CHARS=200

# Retrieval and answer generation
PYRAG_TOP_K=4
PYRAG_LLM_MODEL=gemini-2.5-flash
PYRAG_TEMPERATURE=0.2

# Shared secret for the FastAPI service, sent as X-Rag-Api-Key. Every route
# except /health requires it when set. Keep it set wherever the port is reachable.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PYRAG_API_KEY=
