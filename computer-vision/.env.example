# Copy to .env and fill in. Never commit .env.

# ── This service's own API (X-API-Key on every endpoint except /health) ──
# At least 24 characters, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
CV_API_KEY=change-me-to-a-long-random-value
CV_HOST=127.0.0.1
CV_PORT=8100

# ── The BunonBrain backend ──
CV_BACKEND_URL=http://localhost:5000
# Must equal CV_SERVICE_KEY in the backend's .env (at least 32 characters).
CV_BACKEND_SERVICE_KEY=change-me-to-the-backend-service-key

# ── Model ──
CV_MODEL_PATH=models/yolo11n.pt
# auto | cpu | cuda | cuda:0
CV_DEVICE=auto
CV_CONFIDENCE=0.40
CV_IMAGE_SIZE=640

# ── Processing ──
CV_PROCESS_FPS=8
CV_MAX_SESSIONS=4
CV_MIN_HITS=2
CV_LOST_AFTER_SECONDS=3
CV_TRACK_UPDATE_SECONDS=10
CV_ZONE_DEBOUNCE_FRAMES=2
CV_RECONNECT_ATTEMPTS=5
CV_RECONNECT_DELAY_SECONDS=3
CV_CONFIG_REFRESH_SECONDS=60
CV_WEBCAM_INDEX=0

# ── Events ──
CV_PUBLISH_EVENTS=true
CV_PUBLISH_QUEUE_SIZE=1000
CV_PUBLISH_MAX_ATTEMPTS=5

# ── Development only (keep false in production) ──
CV_ENABLE_PREVIEW=false
CV_PREVIEW_WINDOW=false
CV_ALLOW_SOURCE_OVERRIDE=false

CV_LOG_LEVEL=INFO
