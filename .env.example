# BunonBrain — Environment variables
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the client.
# All others are server-only.
#
# This template is for the Next.js app in frontend/. Copy it to
# frontend/.env.local (or frontend/.env). Next.js loads .env / .env.local /
# .env.<mode> from frontend/ only, NOT from the repo root. The .NET API has its
# own template at backend/FactoryBrain.Api/.env.example
# and loads env files from ITS working directory, not from here.
# Full reference: docs/ENVIRONMENT.md

# ----- Backend URL (server-side; used by next.config.mjs rewrites and
# src/lib/adminProxy.ts). Default when unset: http://localhost:5000.
# Not secret. Keep both equal: the rewrite prefers NEXT_PUBLIC_API_URL,
# the admin proxy prefers DOTNET_API_URL.
# NEXT_PUBLIC_API_URL=http://localhost:5000
# DOTNET_API_URL=http://localhost:5000

# ----- Admin token (server-only secret) -----
# Forwarded as X-Admin-Token by the server-side proxies for
# /api/settings/llm, /api/rag/ingest and /api/rag/reindex. Must equal the
# API's ADMIN_API_TOKEN. Required outside Development, where the API returns
# 403 without it. NEVER prefix with NEXT_PUBLIC_.
# ADMIN_API_TOKEN=

# ----- App flags -----

# Render the internal architecture page at /dev/architecture.
# Leave at false for customer builds. When false the route returns 404.
NEXT_PUBLIC_SHOW_ARCHITECTURE=false

# App display name. NOTE: not read by any current code — titles and the
# topbar are hard-coded. Kept so existing env files stay valid.
# Default below keeps every demo screenshot on the same BD-RMG profile:
# BunonBrain / Factory Brain for a mid-tier Bangladeshi garment plant.
NEXT_PUBLIC_APP_NAME=BunonBrain

# ----- LLM adapter (optional) -----
# When LLM_API_KEY is unset, Ask BunonBrain and Agent runs use the
# deterministic canned responses and show a small "demo mode" chip.

# Provider: gemini | openai | anthropic
LLM_PROVIDER=openai

# API key. NEVER prefix with NEXT_PUBLIC_. Leave blank and enter it in
# Settings → Advanced (/app/settings?section=advanced).
LLM_API_KEY=

# Model id. OpenAI default: gpt-6-luna.
LLM_MODEL=gpt-6-luna

# ----- RAG / Vector Retrieval (optional) -----
# When `EMBEDDING_API_KEY` is unset, factoryBrain falls back to a deterministic
# local semantic vectorizer (token-frequency hashing + BM25 hybrid weighting).
# Set the key below to upgrade embeddings to a hosted provider.

# Embedding provider: openai | voyage. Defaults to "openai" if unset.
EMBEDDING_PROVIDER=

# Embedding API key. NEVER prefix with NEXT_PUBLIC_.
EMBEDDING_API_KEY=

# Embedding model id, e.g. text-embedding-3-small, voyage-2.
EMBEDDING_MODEL=

# Number of chunks retrieved per query (top-k). Defaults to 4.
RAG_TOP_K=4

# Minimum hybrid (cosine + BM25) score a hit must clear to surface.
# 0..1, where 0 disables the gate and ~0.6 is "high-confidence".
RAG_SIMILARITY_THRESHOLD=0

# Convex weight of the BM25 score in the hybrid ranking. 0 = pure dense,
# 1 = pure lexical. Defaults to 0.35.
RAG_BM25_WEIGHT=0.35

# Optional file path where the vector index is persisted between restarts.
# Leave unset to use `<cwd>/.cache/rag-index.json`. Set to `false` to disable
# persistence entirely.
# RAG_PERSIST_PATH=

# ----- Supabase -----
# Not used by the app yet. Reserved for future frontend Supabase features.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# The database connection belongs to the API. See backend/FactoryBrain.Api/.env.example (FACTORYBRAIN_DB).

# ----- API authentication & authorization (Step 52) -----
# See backend/FactoryBrain.Api/.env.example for full docs; these are mirrored
# here so a one-stop lookup exists for operators who only edit the
# frontend .env. All values are placeholders — never commit real keys.

# HS256 secret (≥ 32 UTF-8 bytes). REQUIRED in Production; missing/short
# fails startup. In Development a random 32-byte key is generated
# (tokens don't survive a restart).
# JWT_SIGNING_KEY=

# Lax (default) | Strict | None. Bad values fail startup. None forces
# Secure=true. Case-insensitive.
# AUTH_COOKIE_SAMESITE=Lax

# Optional: seed an Admin user on the very first migration. Both must
# be set; otherwise the seeder is a no-op. The seed runs only when no
# user with the same lowercased email already exists.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me-immediately

# Set to "true" ONLY when the API runs behind a reverse proxy that
# rewrites X-Forwarded-For / X-Forwarded-Proto. Default off so a direct
# exposure cannot be tricked by an inbound header.
# FORWARDED_HEADERS_ENABLED=false
# Comma-separated exact IPs and/or CIDRs of trusted proxies. Empty
# (the default) logs a startup warning and trusts X-Forwarded-For from
# ANY sender — so anyone who can reach the API directly can spoof their
# client IP and bypass the login rate limit. Only leave the list empty
# when the API is reachable exclusively through the proxy; otherwise set
# TRUSTED_PROXIES to your proxy's IP/CIDR. Bad entries fail startup with
# the entry name in the message.
# TRUSTED_PROXIES=10.0.0.0/8,192.168.1.1

# ─── Realtime simulator (Step 53) ──────────────────────────────────────────
# See backend/FactoryBrain.Api/.env.example for full docs. Mirrored here so an
# operator who only edits the frontend .env sees the full picture.
# Set to "true" to drive the live SignalR event stream from inside the
# API. Default off; never enabled unless this var is set.
# SIMULATOR_ENABLED=false
# Optional integer seed for the simulator's RNG. Two runs with the same
# seed produce the same first N sensor readings (after ignoring
# timestamps and ids). Unset = random seed. Invalid values fail startup.
# SIMULATOR_SEED=42
