# Copy this file to .env and fill in your key.
# Relative paths (PDF_PATH, QDRANT_PATH) are resolved against the project folder,
# so the commands work from any directory.

# ---- Gemini (used for the LLM in step 10, and for embeddings by default) ----
# Get a key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# ---- Step 1: which PDF to ingest ----
PDF_PATH=data/sample.pdf

# ---- Step 4: chunking ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ---- Step 5: embeddings ----
# Pick ONE provider. The vector size is detected automatically - you never set it
# by hand - but you MUST re-ingest with --recreate after changing either line.
#   google      = Gemini embeddings (recommended). Uses GOOGLE_API_KEY above.
#                 Best choice for large PDFs on a CPU-only machine.
#   huggingface = local model, no API key, no quota, but CPU-bound
#                 (first run downloads the model).
EMBEDDING_PROVIDER=google
# Model for the provider above:
#   google      -> gemini-embedding-001                     (recommended, 3072-dim)
#   huggingface -> sentence-transformers/all-MiniLM-L6-v2   (fast, English only, 384-dim)
#   huggingface -> BAAI/bge-m3                              (multilingual incl. Bangla, heavy, 1024-dim)
EMBEDDING_MODEL=gemini-embedding-001
# Leave empty to auto-detect the real vector size (recommended).
EMBEDDING_DIM=

# ---- Step 6: Qdrant ----
# Server mode (needed by the HTTP service, main.py):
#   docker run -p 6333:6333 -v qdrant_storage:/qdrant/storage qdrant/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Collection used by the CLI (ingest.py/ask.py). The HTTP service uses one
# collection per Knowledge Base instead (the {collection} in its routes).
COLLECTION_NAME=pdf_rag
# Embedded on-disk store, no server and no Docker. ONLY the CLI scripts can use
# it - main.py returns 501 in this mode. Set to qdrant_data for CLI-only use,
# leave empty for server mode.
QDRANT_PATH=

# ---- Upload (POST /api/kb/{collection}/ingest) ----
# Sensible ceiling, not unlimited.
MAX_UPLOAD_MB=200
# PDFs with less extractable text than this are rejected as scanned/image-based.
MIN_TEXT_CHARS=200

# ---- Step 9: retrieval ----
TOP_K=4

# ---- Step 10: Gemini LLM ----
LLM_MODEL=gemini-2.5-flash
TEMPERATURE=0.2

# Shared secret callers send as X-Rag-Api-Key. When set, every route except
# GET /health requires it. LEAVE IT SET anywhere the port is reachable by others.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RAG_API_KEY=
